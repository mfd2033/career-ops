# Personal data (user fills these)
cv.md
article-digest.md
local/
# Fork-local tests (ADR-0022): tripwire/regression tests for the gitignored
# local/ layer. Gitignored so update-system's tracked-prune and upstream merges
# never touch them; test-all.mjs discovers tests by directory scan, not git.
/tests/local-*.test.mjs
/web/tests/lib/local-*.test.mjs
# Everything under data/ is generated or personal at runtime — only .gitkeep
# placeholders are tracked (verify with `git ls-files data/`). A blanket rule
# means a new generated file (e.g. a future log/cache addition) is covered
# for every user automatically, with no per-filename .gitignore update needed.
data/*
!data/.gitkeep
!data/offers/
!data/parser-output/
# Received offers/contracts, promise notes, prep reports (PII — never commit)
data/offers/*   
!data/offers/.gitkeep
data/parser-output/**
!data/parser-output/**/
!data/parser-output/.gitkeep
!data/parser-output/**/.gitkeep
reports/*.md
!reports/.gitkeep
# Company checkup HTML reports (offer体检 skill output — personal data, ADR-0025)
reports/checkups/
# Company checkup ledger (user-layer data, appended by lib/log-checkup.mjs — never commit)
data/company-checkups.tsv
# Eval-timing instrumentation ledger (user-layer data — never commit)
data/eval-timings.tsv
output/*
!output/.gitkeep
batch/logs/*
!batch/logs/.gitkeep
batch/batch-state.tsv
batch/batch-state-recovery.d/
batch/batch-input.tsv
batch/tracker-additions/**/*.tsv
!batch/tracker-additions/.gitkeep
# Local CV-rebuild data (personal profile + tailored CV content) — never tracked.
batch/cv-rebuild-data.mjs
# Local Zhipin extraction output (scraped JD text) — personal data, never tracked.
batch/zhipin*.txt
batch/zhipin*.json
# Local Zhipin fetch/extract scripts (personal one-off scraping helpers).
/batch/extract-zhipin.cjs
/batch/extract-zhipin.mjs
/fetch-zhipin.cjs
# Local QA repro scripts (hardcode a specific report id + localhost, not part of the node:test suite).
web/qa-*.mjs
jds/*
!jds/.gitkeep

# Personal documents — never commit scans or copies of these (PII).
# Catches common identity/credential filenames so they can't be staged by accident.
*passport*
*diploma*
*简历*
*学位*
*成绩单*

# Interview prep (accumulated STAR+R stories — user data)
interview-prep/*
!interview-prep/
!interview-prep/.gitkeep
# Session transcripts hold real interviewer names/companies — ignore content,
# ship only the system-owned scaffold (README + .gitkeep). #1242
!interview-prep/sessions/
interview-prep/sessions/*
!interview-prep/sessions/.gitkeep
!interview-prep/sessions/README.md

# Writing samples (user's personal files — never committed)
writing-samples/*
!writing-samples/README.md

# User config and customization (never auto-updated)
config/profile.yml
config/cv-facts.json
config/benchmarks.yml
# Inbox keyword vocab user layer (ADR-0068) — personal targeting decisions; the
# tracked template lives in config/keywords.example.yml.
config/keywords.yml
# Fork-local path declarations — this checkout's own files, read by
# update-system.mjs. Gitignored on purpose: it describes THIS clone, not the
# project, and must survive the sync that overwrites update-system.mjs (#2421).
config/local-paths.txt
portals.yml
modes/_profile.md
modes/_custom.md
modes/_brief.md
voice-dna.md
.update-dismissed
.update-lock
.manifesto-noted

# Plugin layer — opt-in toggles + user-installed plugins + integrity lock (never auto-updated)
config/plugins.yml
plugins.local/
plugins.lock

# Secrets (never commit — use .env.example as template)
.env
# Universal safety net — protects ALL checkouts/branches, incl. untracked subprojects
# (e.g. web/ before it graduates to main). Never commit local env files or TS build caches.
**/.env.local
**/.env*.local
**/*.tsbuildinfo

# Generated
.resolved-prompt-*
node_modules/
bun.lock
# Working copy the test suite makes under the repo root (test-all.mjs
# `mkdtempSync(join(ROOT, '.tmp-script-test-'))`). A clean run deletes it; a
# run interrupted mid-way leaves ~650MB of duplicated repo behind, which a
# reflexive `git add .` would then stage as ~1000 new files.
.tmp-script-test-*/

# Report-number reservation sentinels (ephemeral, created by reserve-report-num.mjs)
reports/*-RESERVED.md

# Backup files. Two shapes exist: `{file}.bak` (normalize-statuses.mjs,
# dedup-tracker.mjs, tracker.mjs) and `{file}.bak-{ISO timestamp}`
# (web/src/lib/core/safe-write.ts). A plain `*.bak` glob misses the timestamped
# form, which for cv.md or portals.yml leaves a file holding the same PII as the
# original sitting untracked in the repo root. Trailing `*` covers both.
*.bak*

# OpenRouter runner — generated data (personal, never commit)
data/model-blacklist.json

# OS
.DS_Store
*.mov
*.mp4

# IDE-specific local config
.idea/
.vscode/

# Agent skill storage (local installations; share via skills-lock.json)
.agents/*
!.agents/skills/
.agents/skills/*
!.agents/skills/career-ops/
.agents/skills/*/README.md
.agents/skills/*/SKILL.md
.agents/skills/*/references/
skills-lock.json

# CLI-specific local config
# .claude/ 与 .opencode/ 内的本地文件由文末「AI CLI / IDE 机器本地状态」一节整块覆盖。
# OpenCode project config (often holds personal MCP/model/per-machine prefs).
opencode.json
# Claude Code project-level MCP server config — commonly ends up holding
# personal server credentials (e.g. a plugin's API token) once a user adds
# an MCP server, same risk class as .env.
.mcp.json
career-dashboard
career-dashboard.exe
career-dashboard-ui.exe
career-dashboard-launcher.exe
# Electron 壳产物目录（CareerDashboardTray.exe + resources/app + locales，ADR-0086）
career-tray/
# career-dashboard-*-launcher runtime artifacts (written next to the exe on launch)
/LOCK
/icon.ico
/tray-debug.log
package-lock.json
!web/package-lock.json

# Playwright MCP server run artifacts (ephemeral, machine-local)
.playwright-mcp/
# Computer-use 截图落盘目录（桌面自动化验收留证，机器本地）
.cu-shots/
test-results/
playwright-report/

# Planning (local scratchpad)
plan/
# Ticket/work-order scratch (development working notes — never commit)
.scratch/
# Personal todo store (user-layer data, never commit)
todo-list/

# Web — runtime cache/history the dashboard writes locally; nothing here is tracked.
.career-ops-web/
# Self-contained launcher's extracted runtime (node.exe + Next standalone build +
# lock/tray log) — re-extracted by career-dashboard-ui.exe on launch.
.dashboard-runtime/

# CodeGraph MCP indexing data — machine-local SQLite index + daemon log/pid,
# regenerated by `codegraph init`. Ignore the whole directory so a fresh clone
# never surfaces a 60MB+ untracked index (the nested .codegraph/.gitignore is
# itself local scaffolding, not project content).
.codegraph/

# Upgrade-test fixtures are fictional system-layer data, never user data
# (see DATA_CONTRACT.md). Re-include them past the unanchored user-layer
# patterns above (cv.md, portals.yml).
!test-fixtures/**

# Profile intake sources (master CV / LinkedIn export / diplomas / references
# — user PII, never commit). Ship only the system-owned scaffold. #1723
documents/*
!documents/.gitkeep
!documents/README.md
# Intake fingerprints — the recorded source filenames may themselves carry
# PII (e.g. cv/jane-doe-master-cv.pdf). #1723
data/intake-state.json

# Local environment notes (machine-specific paths / PII, never commit)
MEMORY.md

# Browser profile cache — may hold cookies / saved passwords; NEVER commit
.cache/

# Build/temp artifacts and one-off screenshots
career-dashboard.exe~
career-dashboard-ui.exe~
career-dashboard-launcher.exe~
# 根目录级 UI 截图 / 一次性图片（不入库），如 uu-job-header.png、config-model-select.png
/*.png

# One-off experiment scripts (dev scratch, never commit)
experiments/

# Log / error scratch files
update-apply*.log
update-apply*.err

# Archived evaluation reports (PII — keep out of VCS)
reports/archive/
# Archived evaluation reports (older underscore-prefixed dir — same PII class,
# same rule; a plain `reports/*.md` above only covers the top level, so this
# directory's ~70 reports would otherwise surface as untracked.)
reports/_archive/

# Web dev-server scratch logs (local dev noise, never commit)
web/dev-server*.log*
# Root-level dev server stdout/stderr captures (e.g. dev-out.log / dev-err.log).
/dev-*.log

# Local build log scratch (package-build.log)
package-build.log

# Session-scoped working docs (handoff / pack run logs, ephemeral)
docs/handoff-*.md
docs/pack-*.md
data/agent-inbox.md

# —— AI CLI / IDE 机器本地状态（换机可重建，不入库）——
# 同类规则集中写在这里；另有几项因紧贴相关规则而留在原处：.cache/（浏览器配置，
# 127MB）、.career-ops-web/、.dashboard-runtime/、.codegraph/、.playwright-mcp/、
# .cu-shots/、.scratch/、.tmp-script-test-*/。
# 纯本地产物，整目录忽略：
.trae/
# Trae HTML 预览分享打包产物（机器本地、临时性）
.trae-html-share-packages/
.serena/
# workbuddy 会话记忆 / Qoder IDE 本地状态 / CodeArts IDE-agent 本地状态（索引缓存、
# 临时文件、按机构建的 agent 配置；其嵌套 .gitignore 已是全忽略，这里再写一遍，
# 防止那份文件被删改后索引树漏进库）。
.workbuddy/
.qoder/
.codeartsdoer/
# 桌面自动化 / UI 验收截图落盘目录
.screenshots/

# 各 CLI 的技能分发目录：忽略目录内容，只放行 career-ops 技能本体与命令这类系统层
# 子树。这些路径同时是 update-system.mjs SYSTEM_PATHS / BOOTSTRAP_PATHS 的同步面，
# 整目录忽略会把系统层新增文件挡在库外；目录里其余本地状态照旧不入库。
.claude/*
!.claude/skills/
!.claude/skills/**
.cursor/*
!.cursor/skills/
!.cursor/skills/**
.qwen/*
!.qwen/skills/
!.qwen/skills/**
.kimi/*
!.kimi/skills/
!.kimi/skills/**
.grok/*
!.grok/skills/
!.grok/skills/**
.antigravitycli/*
!.antigravitycli/skills/
!.antigravitycli/skills/**
.opencode/*
!.opencode/skills/
!.opencode/skills/**
!.opencode/commands/
!.opencode/commands/**

# 刻意不忽略：.github/（CI workflow、issue/PR 模板、CODEOWNERS）与 .claude-plugin/
# （插件发布清单）—— 几十个系统层文件已 tracked，整目录忽略对它们无效，只会让以后
# 新增的 workflow/清单项静默漏库，得靠 `git add -f` 才发现。

# 上面的 `!…/skills/**` 放行规则在文件末尾生效，会盖掉上文的 `*.bak*`（上次匹配优先），
# 导致各 CLI 目录下的 SKILL.md.bak 之类备份重新变成未跟踪。末尾补一条把它按回来。
*.bak*
