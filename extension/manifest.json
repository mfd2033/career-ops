{
  "manifest_version": 3,
  "name": "职位评估",
  "version": "0.1.0",
  "description": "在 BOSS直聘 页面对职位快捷评估：详情页/列表快评秒出分数徽章、完整评估生成报告、已评估打标、点击徽章跳本地报告页。",
  "minimum_chrome_version": "110",
  "key": "",
  "permissions": ["storage", "tabs"],
  "host_permissions": ["http://localhost/*", "http://127.0.0.1/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://*.zhipin.com/*"],
      "js": ["core.js", "site-boss.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://*.liepin.com/*"],
      "js": ["core.js", "site-liepin.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://*.zhaopin.com/*"],
      "js": ["core.js", "site-zhaopin.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "职位评估",
    "default_popup": "popup.html"
  }
}